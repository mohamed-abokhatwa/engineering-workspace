# private. Order here is the order shown.
VIDEOS = {
    "overview":   ("BAX19HcAF3c", "Engineering Workspace, the full walkthrough in 5 minutes", "4:27"),
    "gate":       ("n2ofnMcUTGE", "The outbound check that reads your specification before the Engineer does", "2:48"),
    "pour":       ("EokUXUZO3A8", "The concrete date will not wait for your shop drawings", "1:53"),
    "knowledge":  ("1s2m9tv7GTA", "The knowledge base that actually reads your project", "2:05"),
    "registers":  ("KvcYTpHdDq8", "Registers that work for you, not the other way round", "1:36"),
    "workflow":   ("V953S0hWhV0", "600 drawings, real approval chains, zero spreadsheet wars", "1:31"),
    "claims":     ("HbvR64fG0iY", "The claims file that wrote itself while you worked", "1:14"),
    "site":       ("pqNFhNON1Ws", "Snags you can speak, paper checked against the wall", "0:59"),
    "daily":      ("URM3AzR5ygE", "The small tools that carry your working day", "1:12"),
