# ---------------- r150 · pricing ----------------
# Two doors, deliberately different shapes. The personal plan carries a real
# number because an individual decides alone and will not write an e-mail to
# find out; the company licence stays a conversation because it is one.
def plans_block():
    return f"""<div class="plans">
  <div class="plan feat reveal">
    <span class="ribbon">For one engineer</span>
    <h3>Personal</h3>
    <div class="who">You, your project, your machine</div>
    <div class="amt"><b>${PERSONAL_MONTHLY}</b><span>per month</span></div>
    <div class="sar">≈ SAR {int(PERSONAL_MONTHLY * 3.75)} · or ${PERSONAL_YEARLY} a year — two months free · cancel any month</div>
    <p class="pbody">The whole workspace for one person on one project. Not a cut-down
    edition: the same specification reading, the same outbound check, the same studios and
    calculators the company plan gets.</p>
    <div class="checks">
      <div>One engineer, one project — every feature in the product</div>
      <div>Before you send, Before the pour, registers, claims, studios, 43 calculators</div>
      <div>Your documents stay on your own machine · nothing is uploaded to us</div>
      <div>AI features run on your own AI key, so you control that cost separately</div>
      <div>Cancel any month · your files were never ours to hold</div>
    </div>
    <div class="cta">
      <a class="btn btn-primary" href="index.html?plan=personal#request" data-plan="personal">Ask for the personal plan</a>
      <div class="fine">Start with the free 15-day trial if you would rather look first.</div>
    </div>
  </div>
  <div class="plan reveal">
    <h3>Company</h3>
    <div class="who">A team, a floor, a project office</div>
    <div class="amt"><span class="ask">Annual licence</span></div>
    <div class="sar">One price for the workspace · unlimited engineers on it</div>
    <p class="pbody">No per-seat bill and no per-module unlock. Everything the personal plan
    has, plus the parts a company needs: many projects, roles, the client portal, the
    cross-project view and the administration around them.</p>
    <div class="checks">
      <div>Unlimited engineers — adding the fourteenth costs nothing</div>
      <div>Many projects, roles and permissions, audit trail, signed updates</div>
      <div>Client progress portal · you choose what each client sees</div>
      <div>Across-projects intelligence: who answers, what repeats, what to fix</div>
      <div>Runs on your server or your office machine · your data never leaves it</div>
    </div>
    <div class="cta">
      <a class="btn btn-ghost" href="index.html?plan=company#request" data-plan="company">Talk about a company licence</a>
      <div class="fine">Pricing conversations start after you have seen it on your own project.</div>
    </div>
  </div>
</div>
<p class="plannote"><b>How paying works today.</b> Ask for the plan you want and a person answers —
there is no card form on this site yet. Once we have agreed, you receive an invoice and then a
licence key you paste into the app. The key carries your name and its dates; nothing phones home,
and nothing is ever switched off remotely mid-project.</p>"""


def plan_table():
    rows = [
        ("Every engineering feature", "yes", "yes"),
        ("Before you send · the outbound check", "yes", "yes"),
        ("Before the pour · shop drawings against the pouring plan", "yes", "yes"),
        ("Registers, claims ledger, programme, variations", "yes", "yes"),
        ("PDF &amp; CAD studios, 43 calculators, Search &amp; Ask", "yes", "yes"),
        ("Runs on your own machine · documents never leave it", "yes", "yes"),
        ("People on the workspace", "One", "Unlimited"),
        ("Projects", "One", "Unlimited"),
        ("Roles, permissions and the audit trail", "no", "yes"),
        ("Client progress portal", "no", "yes"),
        ("Across every project · company intelligence", "no", "yes"),
        ("Automations, feeds, Teams / Slack posts", "no", "yes"),
        ("Billing", f"${PERSONAL_MONTHLY} monthly", "Annual licence"),
    ]
    body = ""
    for label, a, b in rows:
        def cell(v):
            if v == "yes":
                return '<td class="yes">✓</td>'
            if v == "no":
                return '<td class="no">—</td>'
            return f"<td>{v}</td>"
        body += f"<tr><td>{label}</td>{cell(a)}{cell(b)}</tr>"
    return ('<div class="pscroll"><table class="ptable"><thead><tr><th>&nbsp;</th>'
            '<th>Personal</th><th>Company</th></tr></thead><tbody>'
            + body + "</tbody></table></div>")


def cmp_table():
    parts = []
    for title, sub, rows in CMP_GROUPS:
        parts.append(f"<tr class='grp'><td colspan='3'>{title}"
                     f"<span class='gsub'>{sub}</span></td></tr>")
        parts.extend(
            f"<tr><td>{a}</td><td class='ew yes'>{b}</td>"
            f"<td class='no'>{c}</td></tr>"
            for a, b, c in rows)
    return f'''<div class="cmp-wrap"><table class="cmp reveal"><thead><tr>
<th></th><th class="ew">Engineering Workspace</th>
<th>The construction cloud</th>
</tr></thead><tbody>{"".join(parts)}</tbody></table></div>'''


