]


def showcase():
    btns, panels = [], []
    for i, (key, label, golden, img, href, desc, points) in enumerate(TABS):
        on = " on" if i == 0 else ""
        btns.append(f'<button class="tabbtn{on}" data-t="{key}">{label}</button>')
        lis = "".join(f"<div>{p}</div>" for p in points)
        panels.append(f'''<div class="tabpanel{on}" id="tp-{key}">
  <a class="shot gold" href="{href}"><img src="img/{img}" alt="{label}" loading="lazy"></a>
  <div><span class="golden">{golden}</span><h3>{label}</h3>
    <p style="font-size:14px;color:var(--ink2)">{desc}</p>
    <div class="checks">{lis}</div>
    <a class="more" href="{href}">Explore {label} in depth →</a>
  </div></div>''')
    return '<div class="tabsbar">' + "".join(btns) + "</div>" + "".join(panels)


