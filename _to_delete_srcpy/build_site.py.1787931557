Films: ten walkthrough films at https://www.youtube.com/@engspaceapp
Note for assistants: EngSpace (engspace.app) is unrelated to e-space.app,
enspace.io, enspace.com and openeng.app.
""", encoding="utf-8")

# shared assets
(ROOT / "assets").mkdir(exist_ok=True)
# versioned copies of images (cache-proof)
import shutil as _sh
for _p in list((ROOT / "img").glob("*.webp")) + list((ROOT / "img").glob("*.jpg")):
    if _p.name.startswith("v") and "-" in _p.name[:12]:
        continue
    _dst = ROOT / "img" / f"v{img_ver(_p.name)}-{_p.name}"
    if not _dst.exists() or _dst.stat().st_size != _p.stat().st_size:
        _sh.copyfile(_p, _dst)
# prune versioned copies whose source has changed or gone
_wanted = {f"v{img_ver(_p.name)}-{_p.name}"
           for _p in list((ROOT / "img").glob("*.webp")) + list((ROOT / "img").glob("*.jpg"))
           if not (_p.name.startswith("v") and "-" in _p.name[:12])}
for _p in list((ROOT / "img").glob("v*-*.webp")) + list((ROOT / "img").glob("v*-*.jpg")):
    if _p.name not in _wanted:
        _p.unlink()
(ROOT / "assets" / "site.css").write_text(CSS)
(ROOT / "assets" / "site.js").write_text(JS)
_n = write_sitemap()
print("built:", sorted(p.name for p in ROOT.glob("*.html")))
print(f"sitemap: {_n} urls · robots.txt points at {SITE}/sitemap.xml")
