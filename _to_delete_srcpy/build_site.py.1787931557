</div></section>
""" + jsonld_blocks() + FOOT
write_page("index.html", index, priority="1.0", changefreq="weekly")


# ---------------- feature pages ----------------
def block(img, title, body, points=None, rev=False, cap="", anchor=""):
    lis = "".join(f"<div>{p}</div>" for p in (points or []))
    checks = f'<div class="checks">{lis}</div>' if lis else ""
    aid = f' id="{anchor}"' if anchor else ""
    caph = f'<div class="shotcap">{cap}</div>' if cap else ""
    text = f'<div><h2 style="font-size:24px">{title}</h2><p class="sub" style="font-size:14.5px">{body}</p>{checks}</div>'
    shot = f'<div><div class="shot reveal"><img src="img/{img}" alt="{title}"></div>{caph}</div>'
    inner = (shot + text) if rev else (text + shot)
    return f'<div class="block"{aid}><div class="split{" rev" if rev else ""}">{inner}</div></div>'


def feature_page(fname, title, desc, crumb, hero_sub, blocks, prev, nxt):
    h = page_head(f"{title} — Engineering Workspace", desc)
    h += f'''
<header class="phero"><div class="wrap">
  <div class="crumb"><a href="index.html">Engineering Workspace</a> / {crumb}</div>
  <div class="eyebrow">In depth</div>
  <h1>{title}</h1>
  <p class="sub" style="margin-top:16px">{hero_sub}</p>
</div></header>
<div class="wrap">{blocks}
  <div class="ctaband reveal">
    <div style="flex:1;min-width:260px"><h3>See it on a live workspace.</h3>
    <div style="font-size:13px;color:var(--ink2);margin-top:4px">A real account inside a realistic demo project — request it in one minute.</div></div>
    <a class="btn btn-primary" href="index.html#try">Try the live app →</a>
  </div>
  <div class="pn"><a href="{prev[1]}">← {prev[0]}</a><a href="{nxt[1]}">{nxt[0]} →</a></div>
</div>'''
    write_page(fname, h + FOOT, priority="0.7")


feature_page("dashboard.html", "The Dashboard", "Project health, an AI brief and one ranked attention list.",
    "Dashboard", "Your day starts on one page: how healthy the project is, what needs you first, and why — with every number clickable to its source.",
    block("dashboard.webp", "A front page that thinks",
          "The health score is not a decoration — hover it and it shows exactly how it is scored. KPI tiles carry real day-by-day sparklines, the delivery S-curve sits beside a next-7-days strip that knows your weekend, and the whole layout reorders per account.",
          ["Explainable project-health score", "Customisable blocks, per user", "Live over WebSocket — no refreshing"])
    + block("c_attention.webp", "One ranked list across every module",
          "Overdue register items, follow-ups waiting too long, your own workflow steps, idle reviews, unscreened consultant comments — ranked by urgency in one feed. Click a row and you land on the item itself.",
          ["Ranked: overdue → chases → your steps → idle reviews", "Every row deep-links to the exact item"], rev=True,
          cap="The attention feed — the whole project's 'what needs me', ranked.")
    + block("c_health.webp", "The morning brief — an AI task, clearly labelled",
          "Three sharp sentences written from your real numbers: the most urgent thing, the week's momentum, one concrete action. It runs on an AI account — yours or the workspace's — and when none is connected the dashboard says so politely and everything else keeps working.",
          ["Cached per day, per user, per project", "Never mistaken for an error — AI tasks are badged"],
          cap="Health ring + assistant actions, cropped from the live screen.")
    + caps("Everything the front page does — nothing hidden behind a demo call.", [
        ("Intelligence", [
            ("Project-health score", "One number, fully explainable — hover shows the exact scoring: overdue weight, delivery variance, review idle time."),
            ("AI morning brief", "2–4 sentences from your real numbers; cached per day, per user, per project; refresh rewrites it."),
            ("Needs-attention feed", "One ranked list across registers, workflows, follow-ups, reviews and consultant comments — urgency-ordered."),
            ("Commercial radar line", "Unscreened consultant comments flagged — they may hide variation entitlements.")]),
        ("Numbers that move", [
            ("KPI tiles + sparklines", "Open, due-in-14, overdue, awaiting replies, reviews, your steps — each with a real 14-day sparkline."),
            ("Delivery S-curve", "Planned vs actual earned progress from the EDL's stage weights."),
            ("Next-7-days strip", "What lands each day — and it knows your weekend is not Saturday–Sunday."),
            ("My workflow strip", "Your own pending sign-off steps, one click from acting on them.")]),
        ("Behaviour", [
            ("Per-user layout", "Reorder or hide any block; every account keeps its own dashboard."),
            ("Live updates", "WebSocket push — approvals and arrivals appear without refreshing."),
            ("Deep links", "Every row, tile and chip lands on the exact item, never a module home page."),
            ("Quick actions", "Ask the assistant and new-register-item straight from the hero.")])])
    + versus("Against the field — the front page", [
        ("One ranked to-do across registers, mail, workflows and reviews", "Each product shows its own module's list — nobody merges the project"),
        ("Health score you can interrogate", "Dashboards show counts; the WHY lives in someone's head"),
        ("Weekend-aware 7-day lookahead (Fri–Sat native)", "Western-calendar assumptions, if any lookahead at all")]),
    ("Back to the overview", "index.html#showcase"), ("Design Workflow", "workflow.html"))

feature_page("workflow.html", "The Design Workflow", "The EDL and real sign-off chains with escalation, codes and as-builts.",
    "Design Workflow", "The deliverables list is the backbone of design management — here it is alive: every row knows its chain, its dates, and who is sitting on it.",
    ytone("workflow", "90 seconds of the real workflow: chains, codes, escalation, transmittals.")
    + block("edl.webp", "The EDL — 5,300 rows, no sweat",
          "Filter by discipline and status, import the list you already have in Excel, export the view you are looking at. Every row shows its pending step and who owes it — overdue in red, not in a report next week.",
          ["Import maps your existing columns automatically", "Pagination proven at 5,300+ rows — capacity to 20,000", "Pending step + owner on every row"])
    + block("wfdetail.webp", "A revision's whole life on one card",
          "P02 went through the full chain — including the admin acting for an absent approver, recorded transparently — was issued on transmittal TRN-0141, then the consultant returned Code C. The chain reopened itself and P03 is now mid-review with a working-day due date.",
          ["Originate → check → approve → DC → issue", "Substitutions stamped: who acted for whom", "Codes A–D; C and D reopen the chain automatically"], rev=True)
    + block("myactions.webp", "“My actions” — each engineer's personal queue",
          "Everything waiting on you across every deliverable, with batch approve when it is a stack and a 'While away' delegation so leave never stalls a chain.",
          ["Batch actions up to 100 at once", "Delegation with an end date", "Automatic escalation after 2 working days"])
    + block("c_chain.webp", "As-builts ride the same rails",
          "AB revisions run on the same chains and the same evidence trail, without ever disturbing the issued status of the design record — coverage reported per discipline.",
          ["AB01… labels on the same deliverable", "Issued status never regresses"], rev=True,
          cap="A full chain, cropped from the revision card above.")
    + caps("The full sign-off machine — built inside a mega-project's delivery, not a demo.", [
        ("The EDL", [
            ("Excel import with auto-mapping", "Bring the list you already keep; columns map themselves; re-import updates in place."),
            ("Capacity", "Tested end-to-end at 5,300 rows with 14 engineers acting in parallel; engine reconciled to the row. Handles 20,000."),
            ("View = export", "The filtered view you are looking at exports to Excel exactly as filtered."),
            ("Planned vs actual dates", "Planned issue per row; actual stamped on issue; variance feeds the S-curve."),
            ("Stage-weighted earned value", "Each status carries a percent — progress is earned, not guessed.")]),
        ("Chains & steps", [
            ("Five step kinds", "Originate, discipline check, approve, DC check, issue — per-discipline templates, editable per project."),
            ("Template wizard", "One press creates a default sign-off chain for every discipline."),
            ("Working-day deadlines", "Step durations count working days on YOUR weekend — deadlines never land on Friday."),
            ("Named accountability", "Every step assigned to a person; 'anyone' steps eliminated by design.")]),
        ("Acting on work", [
            ("Batch actions", "Approve or return up to 100 waiting steps in one confirmation."),
            ("Delegation", "'While away' hands your steps to a colleague until a date — every act stamped '[delegate — acted for X]'."),
            ("Admin substitution", "An admin can unblock a chain, transparently: '[admin — acted for X]' in the trail."),
            ("Reassignment", "Move a single step to another engineer without touching the template.")]),
        ("The loop closed", [
            ("Escalation engine", "Due today: nudge. Two working days over: escalate to the next in line. Every three: re-nudge. Automatic, hourly."),
            ("Response codes A–D", "Record the consultant's code per revision; C and D reopen the chain by themselves."),
            ("Transmittals", "Issued deliverables get transmittal records with per-project numbering."),
            ("Auto visual compare", "Each new revision is diffed against the last — removed in red, added in teal — before reviewers open it.")]),
        ("Document control", [
            ("Numbering discipline", "Enforce your document-number pattern (or raw regex); filenames checked on submission."),
            ("Title-block reading", "The sheet's title block is read and checked against the EDL row — scanned sheets included, via vision."),
            ("As-built family", "AB01… revisions on the same deliverable; issued design status protected; coverage report per discipline."),
            ("Full audit", "Who submitted, who acted, who was acted-for, when — permanently on the record.")])])
    + versus("Against the field — design workflow", [
        ("Sign-off chains with delegation, escalation and response codes", "Generic 'review status' fields; chasing lives in someone's memory"),
        ("Working-day clocks on a Fri–Sat weekend", "Calendar-day durations, if durations exist at all"),
        ("As-built revisions on the same record, issued status protected", "As-builts as a separate folder, disconnected from the trail"),
        ("5,300-row EDL exercised with 14 parallel actors — reconciled", "Row limits nobody has tested against a real mega-project list")]),
    ("Dashboard", "dashboard.html"), ("Registers & Claims", "registers.html"))

feature_page("registers.html", "Registers & Claims", "One grid for every register — and a claims ledger that writes itself.",
    "Registers &amp; Claims", "RFIs, submittals, shop drawings, risks: one consistent grid, importable from what you already have — and quietly feeding your entitlement record.",
    ytone("registers", "The registers film: import, the approval clock, the chase pack.")
    + block("registers.webp", "Every register, one behaviour",
          "The same grid, filters, column manager and export everywhere. Import an existing export and the columns map themselves; the approval clock shows who is holding what, oldest first.",
          ["Excel in, Excel/PDF out — the view is the export", "Custom columns and rules per register", "Chase pack: one press, every overdue item"])
    + block("claims.webp", "The claims ledger — the feature the others don't have",
          "Set the contractual review allowances once. From then on every item is measured against them, live: held-vs-allowed clocks, excess days aggregated, notice windows tracked, and a Word evidence pack on demand.",
          ["Computed from the registers you already keep", "Notice deadlines — never miss a 28-day clause", "Monthly exhibit with dates and references"], rev=True, anchor="claims")
    + ytone("claims", "The claims film: entitlement evidence recording itself while you work.")
    + block("c_ledgerrow.webp", "Held vs allowed, item by item",
          "Each row carries its own clock: the teal share is the contractual allowance, the red is the overrun. This is contemporaneous evidence kept by software instead of memory.",
          [], cap="Cropped from the live ledger.")
    + caps("Every register capability, and the claims engine underneath.", [
        ("The grids", [
            ("Seven register types", "RFIs, submittals, shop drawings, long-lead items, risks, deadlines, design issues — one consistent behaviour."),
            ("Custom columns & rules", "Add the columns your project speaks; rules keep entries consistent."),
            ("Column manager", "Show, hide, resize — remembered per register, per user."),
            ("Facet filters + search-every-column", "Slice by any value; the count and the export follow the filter.")]),
        ("In and out", [
            ("Excel import with mapping", "Aconex-style exports map themselves; re-import updates matched rows."),
            ("Excel / PDF export", "Ticked rows if any, else the filtered view, else everything."),
            ("Portal downloads intake", "Files fetched from consultant portals land in an intake queue for filing."),
            ("Supervised portal fetch", "Sign in to the portal yourself — the workspace never holds your portal password.")]),
        ("The clock & the chase", [
            ("Approval clock", "Who is holding what, oldest first — the meeting agenda writes itself."),
            ("Chase pack", "One press: a dated chase list of every overdue item, ready to send."),
            ("Analytics + custom analytics", "Built-in charts plus a builder for the analysis your PM actually asks for."),
            ("Attention feed integration", "Overdue register items rank into the dashboard's one list.")]),
        ("Claims & entitlement", [
            ("Review allowances", "Contractual review periods per type, set once from the contract."),
            ("Held-vs-allowed ledger", "Every open item measured live; excess days aggregate for the claim narrative."),
            ("Notice tracking", "Mark the contractual notice per item; closing windows (e.g. 28 days) tracked."),
            ("Evidence pack", "One press: the monthly Word exhibit — items, dates, references, totals."),
            ("Review-record tie-in", "Deliverable response codes and issue→response times join the entitlement story.")])])
    + versus("Against the field — registers & claims", [
        ("Registers feeding an entitlement ledger automatically", "Logs that record events but never compute entitlement"),
        ("Notice windows with deadlines tracked per item", "A diary note, if the engineer remembered"),
        ("The filtered view IS the export", "Export screens with their own separate logic")]),
    ("Design Workflow", "workflow.html"), ("Before the pour", "pour.html"))

feature_page("pour.html", "Before the pour",
    "Shop drawings and submittals held against the concrete pouring plan — flagged the number of days early you asked for.",
    "Before the pour",
    "The pouring plan is the one date on a construction site that does not move. This holds every pour against the approvals that must exist before it, and warns you while there is still time to chase.",
    ytone("pour", "The pour film: the board, the lead you choose, the reasoning behind every match.")
    + block("pour.webp", "The board that watches the dates that cannot slip",
          "Import the pouring plan you already keep — or paste it out of the spreadsheet. Every pour and every watched installation activity is set against the shop drawings and material submittals that must be approved before that date. You choose how many days early you want to be told; from then on the board answers one question, every morning: what is coming, and is the paperwork ready for it.",
          ["Import an xlsx pouring plan, or paste the rows straight in — the date column finds itself",
           "You set the lead: flag me 7, 14, 21 days before the pour",
           "States that mean something: ready, watching, at risk, blind — and passed, which is the one you never want to see"])
    + block("c_pending.webp", "How it knows which drawing belongs to which pour",
          "This is the part that is easy to get wrong and dangerous to fake. Location tokens are read from the pour and from the document by the SAME extractor — L21, B2, Zone A, Podium, Roof — so a match is a real overlap of words, not a guess. Then the kind of event decides what counts: a concrete pour needs the drawings that carry the cast obligation, while an installation needs the material submittals for the systems it names. Every row shows the reasoning that produced it, so you can disagree with it.",
          ["One extractor reads both sides — the same token means the same thing everywhere",
           "Cast events demand cast drawings; installation events demand the materials for the systems they name",
           "Documents that merely touch the location are shown dimmed and honestly labelled, never counted as cover"], rev=True)
    + block("c_attention.webp", "Your judgement outranks the matcher — and survives the next import",
          "An engineer who links a drawing to a pour by hand is stating a fact the software cannot infer. That link is kept. Re-import the revised pouring plan next month and the human decisions ride through it untouched; only the dates and the machine matches are recomputed. The same is true of a dismissal: tell it that a pour needs nothing and it stops asking.",
          ["Confirm or dismiss any link by hand — it is remembered against the reference, not the row number",
           "Re-importing a revised plan never erases a person's decision",
           "The daily check rings once per date and per missing document — never a second time for the same news"])
    + caps("Everything the board does, plainly.", [
        ("Getting the plan in", [
            ("Import xlsx", "The pouring plan as your planner keeps it. Columns are found by content, not by header text, so a renamed sheet still imports."),
            ("Paste it", "No file needed — paste rows straight from the spreadsheet."),
            ("Merged by reference", "Re-import updates the pour that already exists rather than creating a twin."),
            ("Watch an activity", "Any programme activity can be watched too, not only concrete — risers, ductwork, anything with a paperwork gate.")]),
        ("What it reads", [
            ("The deliverables list", "Shop drawings and their approval state, live."),
            ("The registers", "Shop-drawing and submittal registers — which matters, because many projects keep the record there and nowhere else."),
            ("Approval states, honestly ranked", "Returned outranks approved outranks in-review outranks pending — a returned drawing is not cover."),
            ("Systems vocabulary", "Chilled water, fire fighting, drainage and the rest, so an installation event knows which submittals belong to it.")]),
        ("What it tells you", [
            ("Countdown per event", "The date, and the days between now and it."),
            ("Required list with states", "Each document named, with the state it is actually in."),
            ("Visible reasoning", "Why this document was matched to this pour — always shown, never hidden."),
            ("At risk before it is late", "The flag fires at your chosen lead, not on the day."),
            ("Blind, and said out loud", "A pour with nothing linked is reported as unknown rather than quietly reported as fine.")]),
        ("Staying on it", [
            ("A daily check", "Runs each morning by itself; the bell rings once per new gap."),
            ("Deep link", "The notification opens this board on the event that caused it."),
            ("Dismiss", "An event that genuinely needs nothing stops asking."),
            ("Nothing is sent anywhere", "Like everything else here, it recommends — it never writes to your registers or your mail.")])])
    + versus("Against the field — the pour gate", [
        ("Approvals held against the pouring plan, flagged days early", "A document register and a programme that never speak"),
        ("Location and trade matched by the same extractor on both sides", "A person remembering which drawing covers which slab"),
        ("The engineer's manual link outranks the machine and survives re-import", "A matching rule you cannot correct, or a spreadsheet you must rebuild")]),
    ("Registers & Claims", "registers.html"), ("Search & Ask", "search.html"))

feature_page("search.html", "Search & Ask", "Page-cited answers from your entire archive — on your own server.",
    "Search &amp; Ask", "The archive stops being a place where answers go to hide. Ask in plain language; get the clause, the reply, the drawing note and the calculation — each with its page.",
    ytone("knowledge", "The knowledge-base film: indexing, asking, and the page-cited answer.")
    + block("search.webp", "One question, four sources, three seconds",
          "“Chilled water riser insulation thickness” returns the specification table, the consultant's refusal of the VE proposal, the drawing legend note and the condensation check — ranked, scored, page-cited.",
          ["Meaning + keyword search with reranking", "Every hit shows document, page and heading", "‘Every mention’ sweep for exhaustive coverage"])
    + block("c_hit.webp", "Answers you can defend",
          "A result is only useful in engineering if you can cite it. Every passage carries its document and page — paste it into a reply to the consultant and stand behind it.",
          [], rev=True, cap="A single hit, cropped: score, page, heading, passage.")
    + block("library.webp", "The Library behind it",
          "Folders you recognise, indexed status on every document, and files opening from the project, your OneDrive, your mail attachments or this computer.",
          ["Watched folders index new arrivals automatically", "OCR for scans — English and Arabic", "Same file picker in Library and both Studios"])
    + caps("The intelligence engine, spelled out.", [
        ("Reading", [
            ("Every format that matters", "PDF, Word, Excel, scanned images, drawings — read into one knowledge base."),
            ("OCR, English + Arabic", "Old letters and stamped drawings become searchable text — the archive stops being a blind spot."),
            ("Watched folders", "New arrivals index themselves; the knowledge base is as fresh as the last document."),
            ("Per-project isolation", "Each project keeps its own index — switching projects switches the brain.")]),
        ("Finding", [
            ("Hybrid search", "Meaning-based + keyword, together, reranked — finds 'pump clearance' when the letter says 'access around the skid'."),
            ("Every-mention sweep", "Exhaustive mode: every document that mentions a term, with true counts."),
            ("Ask with citations", "Plain-language answers composed from the evidence, each claim cited (document, p.X)."),
            ("Citations library", "Real answers auto-capture their citations for reuse in letters and reports."),
            ("⌘K everywhere", "The palette searches and jumps from any page.")]),
        ("Economics", [
            ("Runs on your server", "Indexing and search cost nothing per use — a thousand questions a day, zero bill."),
            ("Works offline", "The engine needs no internet; the archive answers on a site cabin generator."),
            ("No data leaves", "Documents, index and questions stay on your hardware.")])])
    + versus("Against the field — search", [
        ("Ask the archive, get a page-cited answer, locally", "Filename search; AI answers only via their cloud, at extra cost"),
        ("Arabic scans readable and searchable", "Latin OCR at best; the Arabic archive stays dark"),
        ("Zero marginal cost per question", "Per-user AI add-ons priced monthly")]),
    ("Before the pour", "pour.html"), ("Mail & Follow-ups", "comms.html"))

feature_page("comms.html", "Mail, Calendar & Follow-ups", "Sent mail becomes tracked promises; meetings arrive pre-briefed.",
    "Mail &amp; Follow-ups", "Connect your own account — sign-in happens at microsoft.com, the app never sees your password — and your correspondence starts working for you.",
    block("followups.webp", "Follow-ups with a brain",
          "Real asks are tracked automatically; meeting invitations, auto-replies and no-reply robots are filtered out. When a thread waits past its patience — counted in working days on your weekend — the bell rings and a chaser is already drafted.",
          ["Replies detected from the inbox automatically", "Patience in working days; weekends never count", "Reopen on resend; quiet threads stay quiet"])
    + block("calendar.webp", "Meetings arrive pre-briefed",
          "The calendar highlights today, and any meeting can produce a prep pack: related documents, open register items on the subject, and recent correspondence — assembled deterministically, cached for the week.",
          ["Prep pack: one press, reused all week", "Open items ranked overdue-first", "Minutes drafted from your rough notes"], rev=True)
    + block("c_fu.webp", "Three states, zero ambiguity",
          "Needs reminder, waiting, replied — every thread tells you its state and its clock at a glance.",
          [], cap="Cropped from the live follow-ups list.")
    + caps("Everything the mail brain does — and everything it deliberately never does.", [
        ("Connection & privacy", [
            ("Your account, your sign-in", "Per-user Microsoft sign-in via the official device-code flow — at microsoft.com, never in the app."),
            ("Per-user encrypted tokens", "No user — and no API — can read another's mailbox. Ever."),
            ("Reads and drafts only", "The workspace never sends mail, never edits your mailbox, calendar or notes.")]),
        ("Follow-ups", [
            ("Track what THEY promised you", "One press on a received e-mail puts the sender's promise on the same board, chased with the same patience — a commitment made to you is a commitment either way."),
            ("Automatic tracking", "Every real ask you send becomes a tracked thread — invites, auto-replies and no-reply robots filtered out."),
            ("Working-day patience", "Choose the patience (e.g. 3 working days); weekends — YOUR weekend — never count."),
            ("Reply detection", "Replies found in the inbox automatically close the wait; a resend after a reply reopens it."),
            ("Drafted chasers", "When patience runs out, a polite chaser is already written — you send it, or not."),
            ("Quiet threads + reopen", "Silence a thread without losing it; every item links back to the original conversation."),
            ("Who owes you", "Each thread names the person and the days — the chase list writes itself.")]),
        ("Calendar & meetings", [
            ("Today, unmistakable", "The calendar marks today so a week view never confuses you."),
            ("Meeting prep packs", "Documents + open register items + recent mail on the subject — deterministic, cached 7 days, saved to your files."),
            ("Minutes from notes", "Rough notes become formal minutes — attendees, decisions, actions with owners."),
            ("Notes → actions", "Apple Notes on the server Mac surface as structured briefs — handwriting included — with each action producible in one press.")]),
        ("Triage & reading", [
            ("AI inbox triage", "Urgent-action / action / awaiting-others / info / noise — with a one-line reason each."),
            ("Letters keep their numbering", "A consultant's five-point letter arrives as five numbered points, not five items all called \u201c1\u201d — the reader takes the rich body and keeps Word's own list numbers."),
            ("The inbox brief", "A composed morning read of the mailbox: act on these, worth knowing, waiting on — each line linked to its thread."),
            ("Attachments in place", "A message's attachments appear as chips and open right there — fetched on demand into a small self-pruning cache, never stored twice."),
            ("The whole thread, then a summary", "Read a conversation from day one in one reader, and press once for a streamed summary of what has been agreed, refused and left open."),
            ("Handwritten notes, read back", "Apple Notes handwriting is transcribed on the server and comes back as a numbered brief — each point extractable into an action the workspace produces."),
            ("Draft replies", "A reply drafted with project facts searched from the knowledge base — never sent by the app."),
            ("Mail into the record", "Ingested correspondence lands in the knowledge base folder, searchable like everything else.")])])
    + versus("Against the field — correspondence", [
        ("Sent mail becomes tracked, chased, working-day-clocked promises", "Mail lives in Outlook; the follow-up lives in memory"),
        ("Meeting prep assembled from mail + registers + documents", "You assemble it yourself, meeting by meeting"),
        ("Drafts only — the app never sends", "Automation products that send on your behalf and get you in trouble")]),
    ("Search & Ask", "search.html"), ("Studios", "studios.html"))

feature_page("studios.html", "The Studios", "PDF markup, CAD opening and revision compare — all in the browser.",
    "Studios", "Drawings are where engineering actually happens. The Studios bring markup, CAD and comparison into the same workspace as everything else — no desktop licences, no exports.",
    block("pdfstudio.webp", "A design review, exactly as it happens",
          "This is the PDF Studio mid-review: a revision cloud around the pumps whose plinths must move, callouts tied to the open RFIs, and a FOR REVIEW stamp — all on the live sheet, listed in the markups rail, saved into the project record.",
          ["Clouds, callouts, arrows, stamps, text, measurements and counts", "Every markup listed, filterable and jumpable in the rail", "Find-in-document searches the sheet's own text"])
    + block("c_markup.webp", "Markup that reads like engineering",
          "Comments carry their references — “Relocate CHWP-01/02 plinths 200 mm east — access clearance per RFI-0492” — so the drawing conversation and the register stay one story.",
          ["Exports look exactly as drawn — clouds and all", "Photos can pin to a location on the sheet"], rev=True,
          cap="The sheet up close: revision cloud, leader callouts, the stamp.")
    + block("library.webp", "Open from anywhere",
          "Both studios share the workspace's file browsing: the project library, your OneDrive, your mail attachments, or a file from this computer. CAD Studio opens DWG/DXF directly in the browser.",
          ["Same file picker in Library and both Studios", "DWG/DXF open without AutoCAD", "Everything saved back into the project record"])
    + block("c_pending.webp", "Compare two revisions, see every change",
          "The compare engine overlays two revisions and paints the differences — removed in red, added in teal — and runs automatically when a new revision is submitted on a workflow.",
          ["Automatic on workflow submissions", "Manual compare for any two PDFs", "Result filed to outputs + linked to the deliverable"], rev=True,
          cap="EDL rows with pending steps — the compare launches from a revision card.")
    + caps("Every markup and drawing capability, named.", [
        ("Markup tools", [
            ("Shapes", "Rectangle, ellipse, cloud (real revision clouds), line, arrow, polyline, polygon, freehand ink, highlight."),
            ("Words on the sheet", "Text boxes, leader callouts, sticky notes — with font size and colour control."),
            ("Stamps", "APPROVED, REJECTED, REVISED, FOR REVIEW, AS-BUILT, VOID — placed and scaled like any markup."),
            ("Apple Pencil on the iPad", "The Pencil draws, a finger still pans and pinches, and the heel of your hand is ignored — so a sheet can be marked up on the tablet you already carry round the site. Pressure changes the weight of the stroke."),
            ("Photo pins", "Attach a photo to a location on the sheet — site condition, meet the drawing."),
            ("Colour discipline", "Six-colour palette so each reviewer or topic keeps its own colour.")]),
        ("Measure & count", [
            ("Calibrated measurement", "Draw a known length once — every measurement after that is in real units."),
            ("Areas", "Polygon areas with the value written on the region."),
            ("Counts", "Numbered count sequences per colour — sprinkler heads, sockets, fixtures — totals kept per sheet.")]),
        ("Working the document", [
            ("Find in document", "Search the sheet's own text; hits highlighted in place."),
            ("Markups rail", "Every annotation listed, clickable, filterable — the review summary writes itself."),
            ("Forms & links", "PDF form fields and page links respected."),
            ("AI reads the sheet", "The vision rail reads title blocks, legends and scanned content on demand."),
            ("Tabs + deep links", "Several documents open at once; a URL opens a specific document and page."),
            ("Exact export", "The exported PDF looks exactly like the screen — clouds, callouts, stamps flattened in place.")]),
        ("CAD & compare", [
            ("DWG/DXF in the browser", "CAD Studio opens native CAD files without AutoCAD on the machine."),
            ("Automatic conversion", "Server-side DWG→DXF conversion picks its own path (no GUI tools needed)."),
            ("Revision compare", "Two PDFs overlaid: removed in red, added in teal, common in grey — auto-run on workflow submissions."),
            ("Filed results", "Compare outputs saved as PDFs into the project's outputs, linked to the deliverable.")])])
    + versus("Against the field — drawings", [
        ("Markup + registers + mail + workflow on ONE record", "Superb markup — in an island; the RFI lives somewhere else"),
        ("Browser-based; nothing to install, nothing per seat", "Desktop installs, per-seat licences, version drift"),
        ("Compare runs itself on every submission", "Manual overlay when someone remembers")]),
    ("Mail & Follow-ups", "comms.html"), ("Calculators", "calculators.html"))

# ---- calculators page: grouped list generated from the REAL manifest ----
import json as _json
_man = _json.load(open(ROOT / "calc_manifest.json"))["calcs"]
_groups_order = ["Hydraulics", "HVAC", "Electrical", "Plumbing", "Fire", "Drainage",
                 "Process", "Structural", "Vertical transport", "Project controls", "Utilities"]
_calc_groups = []
for g in _groups_order:
    items = [(c["label"], ", ".join(p["label"] for p in c["params"][:4])
              + ("…" if len(c["params"]) > 4 else ""))
             for c in _man if c["group"] == g]
    if items:
        _calc_groups.append((f"{g} · {len(items)}", items))

feature_page("calculators.html", "The Calculators", "43 verified engineering calculators — formulas shown, assumptions stated.",
    "Calculators", "The calculations engineers redo in scratch spreadsheets every week — pumps, ducts, cables, storage, traffic — live in the workspace, each showing the formula it used and the assumptions it made.",
    ytone("daily", "The small-tools film: calculators, notes and the daily carry.")
    + block("calculators.webp", "A calculation you can defend",
          "Pump power at 250 m³/h and 38 m: hydraulic 25.89 kW, shaft 33.19 kW, suggested motor 37 kW — with the formula printed under the result and the engineering note that matters. Copy the result, or let the Assistant use it inside a report.",
          ["Formula printed with every result", "Assumptions and defaults visible, editable", "Copy as text, or use directly in AI-written documents"])
    + block("c_calcresult.webp", "Results, not just numbers",
          "Suggested motor ratings, warnings when a value crosses a limit, gauges against thresholds — the calculators answer the next question, not just the arithmetic.",
          ["Limit checks colour the verdict", "Favourites and recent calculators one click away"], rev=True,
          cap="The result card: values, formula, engineering note.")
    + caps("All thirty-five, by discipline — with their main inputs.", _calc_groups)
    + versus("Against the field — calculations", [
        ("43 verified calculators inside the project workspace", "A folder of personal spreadsheets nobody dares audit"),
        ("Formula and assumptions printed with the result", "A cell with =0.746*B4/0.7 and a prayer"),
        ("The Assistant uses the same calculators in written deliverables", "Numbers retyped from Excel into Word, drifting")]),
    ("Studios", "studios.html"), ("Assistant & AI", "assistant.html"))

feature_page("assistant.html", "The Assistant & AI accounts", "A project-grounded assistant — with AI billing that is honest by design.",
    "Assistant &amp; AI", "The assistant searches your indexed evidence, calculates with verified formulas and writes Word/PDF deliverables on your own letterhead — and it never invents what it cannot cite.",
    block("assistant.webp", "Grounded, cited, useful",
          "Ask for a letter about delayed approvals and it searches the registers, quotes the record and produces the Word file — on your company template if you name one. Every claim traces to a document and page.",
          ["Writes docx/PDF deliverables on your template", "Cites (document, p.X) — or says ⟨TBC⟩", "Sub-agents research and check before it reports"])
    + block("aiaccount.webp", "Your AI account — honest by design",
          "AI tasks are badged in the interface and run on an AI account: each user connects their own, so usage bills to them — never silently to the workspace owner. Without one, AI tasks show a friendly connect card and every local feature keeps working.",
          ["Per-user keys, encrypted at rest", "The owner chooses if the workspace AI is shared", "Local features never need an AI account"], rev=True)
    + block("help.webp", "It teaches itself",
          "A one-minute guided tour on first sign-in, a full manual with a what's-new digest, exact how-to hints on every settings card, and a living demo project to practise on.",
          ["Role-aware tour, replayable from Help", "Manual written per role", "Demo Tower: the safe classroom"])
    + caps("What the assistant can actually do — tool by tool.", [
        ("Evidence", [
            ("Search & sweep", "Hybrid search plus exhaustive every-mention sweeps across the indexed project."),
            ("Read any document", "Opens the indexed text of a document, page by page."),
            ("Look at the sheet", "Renders a drawing page and READS it — scanned title blocks, legends, symbols — never guesses."),
            ("Lift printed tables", "Copies a real grid off a PDF page cell by cell — no retyping, no drifted numbers."),
            ("Verify the quote", "Every clause that carries weight is checked verbatim against the source before it is written.")]),
        ("Production", [
            ("Word/PDF deliverables", "Reports, letters, summaries — produced as files, not pasted text."),
            ("Your letterhead kept", "Name a template and it writes INSIDE it — cover page, headers, footers, page numbers, contents field preserved."),
            ("Spreadsheets", "Anything you will sort or total is produced as a real spreadsheet."),
            ("Calculators in documents", "The same 43 verified calculators, used mid-document with the formula cited."),
            ("Live project record", "Reads registers, workflows and status directly — status comes from the record, never from an old PDF.")]),
        ("Discipline", [
            ("Researcher + checker sub-agents", "Wide evidence-gathering, then an adversarial check that tries to prove the draft wrong before you see it."),
            ("Never invents", "No source, no claim — it writes ⟨TBC⟩ and says what to check."),
            ("Asks when ambiguous", "Which template, which revision, which project — it asks instead of guessing."),
            ("Attachments & threads", "Drop files into the conversation; every thread kept, searchable, resumable."),
            ("Personal memory (opt-in)", "Preferences you choose to save shape future answers — per user.")]),
        ("The AI accounts model", [
            ("Per-user keys", "Each person connects their own AI account; usage bills to them, encrypted at rest."),
            ("Owner's sharing policy", "Workspace AI shared with: owner only / admins / everyone — an explicit setting."),
            ("Badged AI tasks", "Every AI feature carries an AI badge; no AI account means a friendly connect card, never an error."),
            ("Local vs AI, honest", "Search, registers, workflows, studios and calculators never need an AI account at all.")])])
    + versus("Against the field — AI", [
        ("AI grounded in YOUR archive, answering with page citations, locally", "Generic AI bolted on their cloud — your documents leave home"),
        ("Writes inside your own letterhead template", "Exports that lose the cover page and the footer every time"),
        ("Per-user AI billing, badge-labelled, optional", "Platform-wide AI fees whether you use them or not")]),
    ("Calculators", "calculators.html"), ("Platform & administration", "platform.html"))

feature_page("platform.html", "Platform & Administration", "Everything around the pillars: programme, variations, reviews, security, growth.",
    "Platform", "The rest of the workspace — the pages that make it an operating system for the engineering office rather than a set of tools.",
    ytone("site", "The on-site film: speak a snag, and the paper meets the wall.")
    + block("tour.webp", "An operating system, not an app bundle",
          "Multi-project workspaces, roles that mean something, automations that sweep hourly, an audit trail that remembers — and an onboarding tour so nobody needs a training course.",
          ["Every pillar shares one project record", "Hourly automations chase so people don't have to", "The guided tour teaches each role its own app"])
    + ytone("headoffice", "The head-office film: across projects, and the client portal your company controls.")
    + block("aiaccount.webp", "Administration without a consultant",
          "Settings are organised into plain sections with a getting-started checklist, exact how-to hints on every card, and growth tools — demo project, value report, security one-pager — built in.",
          ["Getting-started checklist walks the workspace to ready", "Every settings card carries exact click-paths", "Demo project + trial pinning for safe prospect demos"], rev=True)
    + caps("The rest of the platform, page by page.", [
        ("More pillars", [
            ("Programme", "The Primavera P6 programme imported and viewed beside delivery — plan and record in one place, with a three-week look-ahead and the critical path."),
            ("Before the pour", "The concrete pouring plan held against the shop drawings and submittals that must be approved before each date, flagged the days early you choose. <a href='pour.html' style='color:var(--teal)'>The whole board &rarr;</a>"),
            ("Handover dossier", "Closeout obligations counted from the specification clauses themselves and set against what is actually filed — long before the month the building is due."),
            ("Scope & Variations", "A variation register plus a commercial radar that screens consultant comments for hidden entitlement."),
            ("Reviews", "AI document review against the specifications — comment drafts with citations, an engineer approves."),
            ("On site", "Speak a snag and it files itself as the right record; site photos checked against the approved submittal, not a generic checklist."),
            ("Before you send", "The outbound gate: every draft checked against the clauses it relies on before it leaves."),
            ("Compare", "Any two document revisions overlaid — removed in red, added in teal — beyond the automatic workflow compares."),
            ("Across projects", "The head-office view over every workspace project: turnaround, return reasons, repeat conflicts."),
            ("My Notes", "A personal notes board, per user, next to the work."),
            ("History & Jobs", "Every background job visible with progress; every action in the audit trail.")]),
        ("Workspace", [
            ("Multi-project", "Each project keeps its own knowledge base, index, registers and workflows; switching re-points everything."),
            ("Project archive", "Retire a project to a dated archive folder — documents, index and a database export — restorable."),
            ("Notifications centre", "Every completion, arrival and escalation — in-app, and to your phone if you enable push."),
            ("Client portal, company-controlled", "A client sign-in reaches one read-only progress page and nothing else — and YOUR company decides exactly what it shows: every section, the plan comparison, individual disciplines, the transmittal count, even the welcome note. A figure you switch off is never sent, not merely hidden."),
            ("Arabic-ready", "The interface ships with an Arabic RTL option; the engine reads Arabic documents natively.")]),
        ("Trust", [
            ("Sign-in always", "No anonymous access; rate-limited logins; two-factor enforced for administrators."),
            ("Project-pinned accounts", "Trial and demo users locked to one project — your live projects do not exist for them."),
            ("Roles enforced at the server, not the screen", "Five roles — owner, admin, engineer, management, client. What a role may not see is never sent to their browser at all, so a typed address reveals nothing. Audited by signing in as each one and looking."),
            ("The owner's own machine stays the owner's", "Mail, calendar and notes read from the computer the workspace runs on belong to the owner alone · not to the admin role. An administrator can run the whole company here and never see them."),
            ("Encrypted per-user secrets", "Mail sign-ins and AI keys encrypted at rest, per person."),
            ("Signed updates", "Update packages must carry a valid signature to install."),
            ("Backups", "Scheduled local backups plus an encrypted nightly cloud backup of the app record."),
            ("Audit trail", "Logins, changes, approvals, substitutions, escalations — permanent and searchable.")]),
        ("Connections", [
            ("Outlook / Microsoft 365", "Per-user sign-in for mail, calendar and OneDrive — tokens encrypted per user."),
            ("Autodesk Construction Cloud", "Each user signs in to their OWN ACC account on Autodesk's site; the workspace never holds anyone's Autodesk password."),
            ("Portals", "Supervised fetch from consultant portals; downloads land in an intake queue."),
            ("Feeds", "Token-secured calendar and BI feeds for the tools your office already uses."),
            ("MCP both ways", "Your AI agents can plug INTO the workspace, and the workspace can call external agent tools — the AI layer multiplies."),
            ("Automations", "Hourly sweeps (follow-ups, escalations) and a weekly digest — visible, adjustable, off-switchable.")])])
    + versus("Against the field — the platform", [
        ("One integrated record on hardware you own, one workspace price", "Two or three subscriptions, per seat per month, forever"),
        ("Fri–Sat weekends, Arabic documents, GCC reality built in", "Localisation as an afterthought"),
