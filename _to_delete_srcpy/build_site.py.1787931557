    "ownit":      ("evXLLhXwiCs", "Where your data lives: your server, your record", "1:19"),
}


def yt(key, wide=False):
    vid, title, length = VIDEOS[key]
    return (f'<div class="yt{" wide" if wide else ""}" data-yt="{vid}" role="button" tabindex="0" '
            f'aria-label="Play: {title}">'
            f'<button class="ytplay" aria-hidden="true">▶</button>'
            f'<div class="ytmeta"><span>{length} · WATCH</span><b>{title}</b></div></div>')


def ytone(key, cap=""):
    """One film embedded on a feature page, under its hero."""
    c = f'<div class="shotcap" style="margin-top:12px">{cap}</div>' if cap else ""
    return f'<div class="block ytone reveal" style="padding-top:6px">{yt(key)}{c}</div>'


def films_section():
    grid = yt("overview", wide=True) + "".join(
        yt(k) for k in ("gate", "pour", "knowledge", "workflow", "registers",
                        "claims", "site", "daily", "headoffice", "ownit"))
    return f'''
<section id="films"><div class="wrap">
  <div class="eyebrow">The walkthrough library</div>
  <h2>Eleven short films. The whole product.</h2>
  <p class="sub">Every film is the real application moving on the living demo project — no slides,
  no mock-ups. Start with the full walkthrough, then pick the part of your day you want back.</p>
  <div class="ytgrid reveal">{grid}</div>
  <div class="ytnote">Films play right here ·
    <a href="{CHANNEL}" target="_blank" rel="noopener">visit the channel</a> for the full playlist.</div>
</div></section>'''

# ---------------- FAQ (index) + structured data ----------------
FAQ = [
    ("What is EngSpace, in one sentence?",
     "EngSpace, the Engineering Workspace, is a project intelligence platform for "
     "engineering and construction offices: it reads your contract, specifications, "
     "drawings and correspondence, checks what you are about to issue against them, "
     "and keeps registers, sign-off workflows, claims evidence, drawing studios and "
     "a client portal around that one record, on a server you own."),
    ("Where does my project data live?",
     "On your own infrastructure. Documents, the search index and the database stay "
     "on the machine your company operates; the engine reads, OCRs and answers "
     "locally. Remote access happens through an encrypted tunnel with sign-in "
     "always required, and nothing is stored in a vendor cloud."),
    ("What does it cost?",
     f"Two ways in. One engineer on one project pays ${PERSONAL_MONTHLY} a month "
     f"(or ${PERSONAL_YEARLY} a year) and gets every feature. A company pays one annual "
     "price for the workspace with unlimited engineers and projects. There is no per-seat "
     "bill, no per-module unlock, and no charge for the calculators or the studios. "
     "AI tasks run on your own AI key, so there is no per-question fee to us. "
     "The full picture is on the pricing page, and a free 15-day trial comes first."),
    ("Does it read Arabic documents?",
     "Yes. Scanned Arabic letters and stamped drawings are OCRed and become "
     "searchable alongside English, and the interface itself ships with a full "
     "Arabic right-to-left option."),
    ("How does the AI stay honest?",
     "Every answer must cite its source, document and page. When the evidence is "
     "not there, the assistant writes TBC instead of inventing, and a checker pass "
     "tries to prove drafts wrong before you see them. Search, registers, workflows "
     "and calculators are deterministic local features that need no AI account at all."),
    ("How should I test it?",
     "Request the trial — it installs on your own machine, so you can point it at "
     "the real project without anything leaving your computer — and try to "
     "break it: ask questions where two clauses conflict, where the wrong code "
     "edition is cited, or where a previous Engineer response changed the "
     "interpretation. Catching those is the whole point of the outbound check."),
    ("What does the trial install need from my machine?",
     "A 64-bit machine with 8 GB of memory (16 GB is comfortable) and room on an "
     "SSD for your documents plus about 15% for the index. The installer carries "
     "everything else — runtime, search models, Arabic-English OCR — and the "
     "first run benchmarks your computer and tells you what it can comfortably "
     "carry. The details are on the requirements page."),
]


def faq_section():
    items = "".join(
        f'<div class="cap" style="padding:17px 19px"><b style="font-size:13.5px">{q}</b>'
        f'<span style="font-size:12.5px;margin-top:6px">{a}</span></div>'
        for q, a in FAQ)
    return f'''
<section id="faq"><div class="wrap">
  <div class="eyebrow">Asked before the trial</div>
  <h2>Plain answers first.</h2>
  <div class="caps" style="margin-top:30px;grid-template-columns:repeat(auto-fit,minmax(330px,1fr))">{items}</div>
</div></section>'''


def jsonld_blocks():
    import json as _j
    org = {
        "@context": "https://schema.org", "@type": "Organization",
        "name": "EngSpace", "alternateName": "Engineering Workspace",
        "url": SITE, "logo": f"{SITE}/assets/mark.svg",
        "email": EMAIL,
        "founder": {"@type": "Person", "name": "Mohamed Abokhatwa",
                    "url": "https://abokhatwa.com",
                    "jobTitle": "Founder and engineer"},
        "sameAs": ["https://www.youtube.com/@engspaceapp",
                   "https://abokhatwa.com"],
        "areaServed": "Middle East and worldwide",
    }
    app = {
        "@context": "https://schema.org", "@type": "SoftwareApplication",
        "name": "Engineering Workspace",
        "alternateName": "EngSpace",
        "url": SITE, "applicationCategory": "BusinessApplication",
        "operatingSystem": "Self-hosted server, used from any browser",
        "description": ("Project intelligence for engineering offices: document-"
                        "grounded AI with page citations, an outbound check for "
                        "RFIs and submittals, registers, sign-off workflows, "
                        "claims evidence, drawing studios, 43 calculators and a "
                        "company-controlled client portal, on infrastructure you own."),
        "inLanguage": ["en", "ar"],
        # r150 · two real offers, so the personal price is machine-readable
        "offers": [
            {"@type": "Offer", "name": "Personal",
             "price": str(PERSONAL_MONTHLY), "priceCurrency": "USD",
             "description": ("One engineer on one project, every feature. "
                             f"${PERSONAL_MONTHLY} per month, or ${PERSONAL_YEARLY} per year."),
             "url": f"{SITE}/pricing.html",
             "priceSpecification": {
                 "@type": "UnitPriceSpecification",
                 "price": str(PERSONAL_MONTHLY), "priceCurrency": "USD",
                 "referenceQuantity": {"@type": "QuantitativeValue",
                                       "value": 1, "unitCode": "MON"}}},
            {"@type": "Offer", "name": "Company",
             "priceCurrency": "USD", "description":
             "One annual workspace licence, unlimited engineers and projects. Price on request.",
             "url": f"{SITE}/pricing.html"},
        ],
        "featureList": [
            "Outbound check against the specification before an RFI or submittal is sent",
            "Shop drawings and submittals held against the concrete pouring plan",
            "Page-cited answers across the whole document archive",
            "Registers with an entitlement and delay ledger that computes itself",
            "Deliverables list with real sign-off chains and escalation",
            "PDF markup and DWG/DXF studios with revision compare",
            "43 verified engineering calculators",
            "Client progress portal the company controls figure by figure",
        ],
        "softwareVersion": "2.0",
    }
    faq = {
        "@context": "https://schema.org", "@type": "FAQPage",
        "mainEntity": [{"@type": "Question", "name": q,
                        "acceptedAnswer": {"@type": "Answer", "text": a}}
                       for q, a in FAQ],
    }
    DUR = {"overview": "PT4M27S", "gate": "PT2M48S", "pour": "PT1M53S",
           "knowledge": "PT2M5S", "registers": "PT1M36S", "workflow": "PT1M31S",
           "claims": "PT1M14S", "site": "PT59S", "daily": "PT1M12S",
           "headoffice": "PT1M52S", "ownit": "PT1M19S"}
    vids = []
    for key, (vid, title, _len) in VIDEOS.items():
        vids.append({
            "@context": "https://schema.org", "@type": "VideoObject",
            "name": title,
            "description": f"{title} · a walkthrough film of the Engineering Workspace, recorded on the live demo project.",
            "thumbnailUrl": f"https://i.ytimg.com/vi/{vid}/hqdefault.jpg",
            "uploadDate": "2026-08-26",
            "duration": DUR.get(key, "PT2M"),
            "embedUrl": f"https://www.youtube-nocookie.com/embed/{vid}",
            "url": f"https://youtu.be/{vid}",
        })
    blocks = [org, app, faq] + vids
    return "".join(f'<script type="application/ld+json">{_j.dumps(b, ensure_ascii=False)}</script>'
                   for b in blocks)


# ---------------- index ----------------
index = page_head(
    "EngSpace · Engineering Workspace — it stops you sending something wrong, and it proves you were right",
    "Reads your contract, specifications, drawings and correspondence, checks what you are about to issue against them, and keeps the record that protects you when the answer is slow. On infrastructure you own.")
index += f"""
<header class="hero" id="top"><div class="wrap">
  <div class="eyebrow">Engineering intelligence for design &amp; construction offices</div>
  <h1>It stops you sending<br>something <em>wrong</em>.<br>And it proves you were right.</h1>
  <p class="sub">The workspace reads your contract, specifications, drawings and years of
  correspondence — then checks what you are about to issue against them, and keeps the record that
  protects you when the answer is slow. Registers, drawings, workflows and claims around it, on
  infrastructure <b>you</b> own. Built inside the delivery of a mega-project, not in a demo lab.</p>
  <div class="cta-row">
    <a class="btn btn-primary" href="#try">Try the live app →</a>
    <a class="btn btn-ghost" href="#showcase">See what it does</a>
  </div>
  <div class="statband reveal">
    <div class="stat"><div class="v"><span data-count="72000">72,000</span><span class="u">+</span></div>
      <div class="l">Ask your archive</div><div class="s">documents indexed on one live project — every answer cites its exact page</div></div>
    <div class="stat"><div class="v"><span data-count="43">43</span></div>
      <div class="l">Engineering calculators</div><div class="s">pumps to gensets to lifts — the formula printed with every result</div></div>
    <div class="stat"><div class="v"><span data-count="5300">5,300</span></div>
      <div class="l">Sign-offs, proven</div><div class="s">EDL rows moving through real chains — 14 engineers in parallel, reconciled</div></div>
    <div class="stat"><div class="v">100<span class="u">%</span></div>
      <div class="l">Yours</div><div class="s">your hardware, one workspace price — no per-seat cloud, no data leaving</div></div>
    <div class="stat"><div class="v">EN<span class="u">+</span>AR</div>
      <div class="l">Reads everything</div><div class="s">scanned letters and stamped drawings, searchable in both languages</div></div>
  </div>
  <div class="frame reveal"><div class="bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="url">engineering-workspace — your project's front page</span></div>
    <img src="img/dashboard.webp" alt="The dashboard" loading="eager">
  </div>
</div></header>

<section id="gate" style="background:var(--bg2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)"><div class="wrap">
  <div class="eyebrow">The check that runs before anything leaves</div>
  <h2>Your own documents already know<br>what is wrong with that letter.</h2>
  <p class="sub">An RFI, a letter, a submittal cover, a claim notice. Paste it in and the workspace
  retrieves the clauses it relies on — the whole section, not the sentence somebody remembered —
  and answers six questions before the Engineer gets the chance to.</p>
  <div class="vals">
    <div class="val reveal"><div class="num">01</div><h3>Do the clauses say what you claim?</h3>
      <p>Every specification section, drawing and code the draft leans on is retrieved and read. A quotation that does not survive its own source is found here, not in the response.</p></div>
    <div class="val reveal"><div class="num">02</div><h3>Is there a clause that contradicts you?</h3>
      <p>The one nobody thinks to look for: a requirement elsewhere in the same section that forbids exactly what you are proposing. A draft claiming compliance while breaching an unmentioned clause is worse than one that asks openly.</p></div>
    <div class="val reveal"><div class="num">03</div><h3>Is that the edition your contract binds?</h3>
      <p>A standing register of every code the contract binds, at which edition, against which edition is actually on your shelf. A section number taken from a later edition is a rejection that looks like a technicality and costs a full cycle.</p></div>
    <div class="val reveal"><div class="num">04</div><h3>Are you deviating without saying so?</h3>
      <p>Undeclared deviations are what turn a technical discussion into a credibility problem. Declared ones get approved. The check names each one and drafts the sentence that declares it.</p></div>
    <div class="val reveal"><div class="num">05</div><h3>Have you made a claim one example destroys?</h3>
      <p>"No longer available anywhere" invites a reviewer to spend ten minutes disproving you, and then to read the rest of your submission with suspicion. It is replaced with what was surveyed, when, and by whom.</p></div>
    <div class="val reveal"><div class="num">06</div><h3>Is there a required response date?</h3>
      <p>Without one, a six-week silence leaves no position worth arguing. The check refuses to call a draft ready until it says when an answer is needed and what that answer protects.</p></div>
  </div>
  <div class="diagram reveal" style="margin-top:40px">
    <div class="node"><div class="t">Your draft</div><div class="d">RFI · letter · submittal cover<br>claim notice · method statement</div></div>
    <div class="arrow">&#10148;</div>
    <div class="node brain"><div class="t">Read against your own archive</div><div class="d">clauses retrieved and read whole —<br>editions, conflicts, acceptable makers,<br>and what this Engineer ruled before</div></div>
    <div class="arrow">&#10148;</div>
    <div class="node"><div class="t">Hold &#183; revise &#183; send</div><div class="d">with the clause that contradicts you<br><b style="color:var(--teal)">quoted, and where it sits</b></div></div>
  </div>
