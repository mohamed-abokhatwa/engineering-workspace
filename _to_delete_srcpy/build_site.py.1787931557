def page_head(title, desc):
    return HEAD.format(title=title, desc=desc, n_show="", n_eng="", n_cmp="", n_sec="", n_pri="")




def caps(intro, groups):
    """The complete capability list — every feature, named."""
    out = [f'<div class="capshead"><div class="eyebrow">Every capability, declared</div>'
           f'<h2 style="font-size:24px">The complete list.</h2>'
           f'<p class="sub" style="font-size:14px">{intro}</p></div>']
    for title, items in groups:
        cards = "".join(f'<div class="cap"><b>{n}</b><span>{d}</span></div>' for n, d in items)
        out.append(f'<div class="capgroup"><h3>{title}</h3><div class="caps">{cards}</div></div>')
    return "".join(out)


def versus(title, rows):
    """Against the field — ours vs the archetypes, feature by feature."""
    body = "".join(f'<div class="vsrow"><div class="us">{a}</div><div class="them">{b}</div></div>'
                   for a, b in rows)
    return (f'<div class="vsbox reveal"><div class="vshead">{title}</div>{body}</div>'
            f'<p style="font-size:11.5px;color:var(--ink3);margin-top:10px">'
            f'"The field" is the usual toolchain — the per-user construction cloud and the '
            f'separate applications around it. Good tools; the difference here is one integrated '
            f'record, on your own server.</p>')


